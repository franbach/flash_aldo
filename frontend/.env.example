# Frontend runtime configuration (Vite)
# Copy to .env.local (recommended) and adjust as needed.

# GraphQL endpoint
VITE_GRAPHQL_URL=http://localhost:3000/graphql

# Rails ActionCable websocket endpoint
VITE_CABLE_URL=ws://localhost:3000/cable

# Credentials mode for GraphQL requests
# Valid values: omit | same-origin | include
VITE_GRAPHQL_CREDENTIALS=same-origin
